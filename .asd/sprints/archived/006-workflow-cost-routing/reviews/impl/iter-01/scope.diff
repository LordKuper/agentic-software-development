+    }
+    for (const id of Object.keys(entries)) if (!expected.has(id)) fail(`manifest n_a.${label} unknown id: ${id}`);
+    return out;
+  };
+  const findingIds = Array.isArray(ledger.findings) ? ledger.findings : [];
