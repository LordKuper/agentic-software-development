+    rules: manifest.rules.map((i, index) => (index === 0 && findings.length > 0 ? { i, s: vocabulary.f, f: findings[0] } : manifest.n_a.rules[i] ? { i, s: vocabulary.p, p: manifest.n_a.rules[i][0] } : { i, s: vocabulary.rules[0] })),
