diff --git a/.asd/rules/sprint-lifecycle.md b/.asd/rules/sprint-lifecycle.md
index c8b8d37..d57f894 100644
--- a/.asd/rules/sprint-lifecycle.md
+++ b/.asd/rules/sprint-lifecycle.md
