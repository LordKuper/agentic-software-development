+  assert.ok(toAwait.length === 1 && /merge mode/.test(toAwait[0].if) && !/open mode/.test(toAwait[0].if), `AC-5: the Exit table routes await-merge from merge mode alone, got ${JSON.stringify(toAwait)}`);
