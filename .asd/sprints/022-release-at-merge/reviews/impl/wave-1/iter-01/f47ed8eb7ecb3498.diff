diff --git a/.asd/rules/checkpoints.md b/.asd/rules/checkpoints.md
index 682c739..2c0ad6e 100644
--- a/.asd/rules/checkpoints.md
+++ b/.asd/rules/checkpoints.md
@@ -4,7 +4,7 @@
 
